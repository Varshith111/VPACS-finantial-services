# ---------------------------------------------------------------------------
# VPACS Financial Services — Environment Variables
# Copy this file to ".env" and fill in the values from your Firebase console.
# All Vite env vars MUST be prefixed with VITE_ to be exposed to the client.
# ---------------------------------------------------------------------------

# Firebase (Google Authentication)
# Create a project at https://console.firebase.google.com and enable
# Authentication > Sign-in method > Google.
VITE_FIREBASE_API_KEY=your_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
VITE_FIREBASE_APP_ID=your_app_id

# Contact / business details (used across the site)
VITE_CONTACT_PHONE=+91 00000 00000
VITE_CONTACT_EMAIL=info@vpacs.in
VITE_WHATSAPP_NUMBER=910000000000

# Optional: Formspree / form endpoint for the contact form.
# If left blank, the contact form falls back to a mailto: submission.
VITE_CONTACT_FORM_ENDPOINT=
